+#define NM_ORIG_GET(p, d, i, n, b, s, fv)   (p)->orig->get((p)->orig, (d), (i), (n), (b), (s) fv)
+#define NM_ORIG_SET(p, d, i, n, b, s, f)    (p)->orig->set((p)->orig, IDMAP_CALL (d), (i), (n), (b), (s), (f))
+#endif
+/* ===== end 4.4 compat shims ===== */
