+#define full_name_hash(salt, name, len) full_name_hash(name, len)
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 6, 0)
+#define in_compat_syscall() is_compat_task()
+#endif
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 9, 0)
+#define nm_vfs_getxattr(d, i, n, b, s)      vfs_getxattr((d), (n), (b), (s))
+#define nm_vfs_setxattr(d, i, n, b, s, f)   vfs_setxattr((d), (n), (b), (s), (f))
+#define NM_ORIG_GET(p, d, i, n, b, s, fv)   (p)->orig->get((p)->orig, (d), (n), (b), (s))
+#define NM_ORIG_SET(p, d, i, n, b, s, f)    (p)->orig->set((p)->orig, (d), (n), (b), (s), (f))
+#else
+#define nm_vfs_getxattr(d, i, n, b, s)      __vfs_getxattr((d), (i), (n), (b), (s))
