diff --git a/drivers/gpu/msm/adreno_a5xx.c b/drivers/gpu/msm/adreno_a5xx.c
index 2514d13b..b7050132 100644
--- a/drivers/gpu/msm/adreno_a5xx.c
+++ b/drivers/gpu/msm/adreno_a5xx.c
@@ -144,6 +144,7 @@ static void a530_efuse_speed_bin(struct adreno_device *adreno_dev)
 {
 	unsigned int val;
 	unsigned int speed_bin[3];
+	unsigned int force_bin;
 	struct kgsl_device *device = &adreno_dev->dev;
 
 	if (of_property_read_u32_array(device->pdev->dev.of_node,
@@ -153,6 +154,25 @@ static void a530_efuse_speed_bin(struct adreno_device *adreno_dev)
 	adreno_efuse_read_u32(adreno_dev, speed_bin[0], &val);
 
 	adreno_dev->speed_bin = (val & speed_bin[1]) >> speed_bin[2];
+
+	/*
+	 * OC OVERRIDE (opt-in only, NOT enabled by any normal/baseline
+	 * build): if "qcom,gpu-force-speed-bin" is present in the board DT,
+	 * ignore the efuse-read value and force the GPU's power-level table
+	 * lookup (see adreno.c, of_find_node_by_name(... "qcom,gpu-pwrlevel-
+	 * bins" ...)) to match a DIFFERENT (typically better-binned) group
+	 * than the one the physical silicon actually reports. This is a
+	 * HIGH-RISK CROSS-BIN operation: no new frequency/voltage point is
+	 * added, an existing table calibrated for other silicon is simply
+	 * selected instead. See the oc_*.conf files under configs/ for opt-in usage.
+	 */
+	if (!of_property_read_u32(device->pdev->dev.of_node,
+			"qcom,gpu-force-speed-bin", &force_bin)) {
+		KGSL_CORE_ERR(
+			"OC OVERRIDE: forcing GPU speed_bin %u (efuse override, HIGH RISK)\n",
+			force_bin);
+		adreno_dev->speed_bin = force_bin;
+	}
 }
 
 static const struct {
