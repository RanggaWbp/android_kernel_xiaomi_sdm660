/* ramoops dts configuration */
/ {
	reserved-memory {
		ramoops_mem: ramoops_region@a0000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0 0xA0000000 0 0x00400000>;
		};
	};
};

&soc {
	ramoops {
		compatible = "ramoops";
		memory-region = <&ramoops_mem>;
		/*
		 * Zone sizes must match the ones the recovery kernel uses for
		 * this region: console 2 MiB at offset 0, pmsg 2 MiB after it,
		 * and no dumps zone (record-size absent). Recovery maps the same
		 * physical range and validates every persistent_ram zone by its
		 * signature, so any other layout leaves /sys/fs/pstore empty in
		 * recovery -- which is the only place a panic can be read back
		 * from on this device. The panic output still lands in the
		 * console ring, so nothing is lost by dropping the dumps zone.
		 */
		console-size = <0x200000>;
		pmsg-size = <0x200000>;
	};
};
