/* ramoops dts configuration */
/ {
	reserved-memory {
		ramoops_mem: ramoops_region@a0000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0 0xA0000000 0 0x00400000>;
		};
	};
};

&soc {
	ramoops {
		compatible = "ramoops";
		memory-region = <&ramoops_mem>;
		/*
		 * record-size is what creates the oops/panic dump zone. Without
		 * it ramoops only keeps console + pmsg, so a panic leaves
		 * nothing in /sys/fs/pstore after the reboot.
		 * Budget of the 4 MiB region:
		 *   record 256 KiB (x7 dumps) + console 256 KiB + pmsg 2 MiB.
		 */
		record-size = <0x40000>;
		console-size = <0x40000>;
		pmsg-size = <0x200000>;
	};
};
